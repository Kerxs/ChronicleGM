{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronicle GM 安装程序",
  "version": "0.0.6",
  "identifier": "com.chroniclegm.setup",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chronicle GM 安装程序",
        "width": 640,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#f4f6fa"
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"] }
}
