{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronicle GM",
  "version": "0.0.2",
  "identifier": "com.chroniclegm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chronicle GM",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "backgroundColor": "#f5f5f7",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "shortDescription": "本地 AI TRPG 主持与内容创作工具",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2MTU2RjNGRTk3MjQ5ODUKUldTRlNYTHBQMjhWWnBKeTBCdmFRQXpLUHBVaHg5dXY3MURkUnBsNW1Fb3VBQUFiTFNTVm9CaTAK",
      "endpoints": [
        "https://github.com/Kerxs/ChronicleGM/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}